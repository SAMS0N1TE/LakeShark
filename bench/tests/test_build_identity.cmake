include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ls_build_identity.cmake")
function(expect product revision state wanted)
    ls_identity_format(actual "${product}" "${revision}" "${state}")
    if(NOT "${actual}" STREQUAL "${wanted}")
        message(FATAL_ERROR "identity '${actual}' != '${wanted}'")
    endif()
    string(LENGTH "${actual}" length)
    if(length GREATER 31)
        message(FATAL_ERROR "identity would be truncated")
    endif()
endfunction()
set(sha "fc9fb81012345678901234567890123456789012")
expect("2.1.0-rc1" "${sha}" clean "2.1.0-rc1-gfc9fb8101234")
expect("2.1.0-rc1" "${sha}" dirty "2.1.0-rc1-gfc9fb8101234-dirty")
expect("2.1.0-rc1" "" archive "2.1.0-rc1-archive")
expect("2.1.0-rc0" "${sha}" clean "0-gfc9fb8101234")
expect("1.0.1" "${sha}" clean "1.0.1-gfc9fb8101234")
expect("1.0.1" "${sha}" dirty "1.0.1-gfc9fb8101234-dirty")
expect("1.0.1" "" archive "1.0.1-archive")
expect("1.0.1" "${sha}" unknown "1.0.1-unknown")
expect("1.0.1" "bad;message(FATAL_ERROR injected)" clean "1.0.1-unknown")
expect("1.0.1" "abc123" clean "1.0.1-unknown")
expect("1.0.1" "${sha}\nINJECT" clean "1.0.1-unknown")
expect("1;evil" "${sha}" dirty "0-gfc9fb8101234-dirty")
expect("1234567890" "${sha}" dirty "1234567890-gfc9fb8101234-dirty")
expect("12345678901" "${sha}" dirty "0-gfc9fb8101234-dirty")
expect("1.0.1" "FC9FB81012345678901234567890123456789012" clean "1.0.1-gfc9fb8101234")
expect("1.0.1" "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" clean "1.0.1-gaaaaaaaaaaaa")
ls_identity_query(archive "${CMAKE_CURRENT_BINARY_DIR}/missing-source-archive" "1.0.1")
if(NOT archive STREQUAL "1.0.1-archive")
    message(FATAL_ERROR "archive borrowed a parent repository")
endif()
set(test_dir "${CMAKE_CURRENT_LIST_DIR}/../build/identity-tests")
file(MAKE_DIRECTORY "${test_dir}")
set(metadata "${test_dir}/project_description.json")
file(WRITE "${metadata}" "{\"project_version\":\"old\",\"other\":\"unchanged\"}\n")
ls_identity_write_metadata("${metadata}" "1.0.1-gfc9fb8101234-dirty")
file(READ "${metadata}" actual)
if(NOT actual STREQUAL "{\"project_version\": \"1.0.1-gfc9fb8101234-dirty\",\"other\":\"unchanged\"}\n")
    message(FATAL_ERROR "metadata mismatch: ${actual}")
endif()
ls_identity_write_header("${test_dir}/identity.h" "1.0.1-archive")
ls_identity_write_header("${test_dir}/identity.h" "1.0.1-gfc9fb8101234-dirty")
file(READ "${test_dir}/identity.h" header)
if(NOT header MATCHES "PROJECT_VER \"1.0.1-gfc9fb8101234-dirty\"")
    message(FATAL_ERROR "incremental header refresh failed")
endif()
message(STATUS "19 build identity checks passed")
