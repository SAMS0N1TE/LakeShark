# Firmware modules (components/apps/tui/ls_mod.h): which sources leave the
# firmware image for this configuration. The list is
# components/apps/modules/modules.json, read here and by build_modules.py.
set(LS_MODULES_JSON ${CMAKE_CURRENT_LIST_DIR}/../components/apps/modules/modules.json)

# ls_modules_list(<out variable>): project-relative paths of every source
# that lives in a module in this configuration; empty without modules.
function(ls_modules_list out_var)
    set(result "")
    if(CONFIG_LS_APP_MODULES)
        file(READ ${LS_MODULES_JSON} j)
        string(JSON n LENGTH "${j}" modules)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
            string(JSON m GET "${j}" modules ${i})
            string(JSON cond ERROR_VARIABLE err GET "${m}" unless)
            if(NOT cond MATCHES "NOTFOUND$" AND CONFIG_${cond})
                continue()
            endif()
            string(JSON cond ERROR_VARIABLE err GET "${m}" if)
            if(NOT cond MATCHES "NOTFOUND$" AND NOT CONFIG_${cond})
                continue()
            endif()
            string(JSON ns LENGTH "${m}" srcs)
            math(EXPR slast "${ns} - 1")
            foreach(k RANGE ${slast})
                string(JSON f GET "${m}" srcs ${k})
                list(APPEND result "${f}")
            endforeach()
        endforeach()
    endif()
    set(${out_var} ${result} PARENT_SCOPE)
endfunction()

# ls_modules_filter(<list variable> <component path prefix>)
# Removes from a source list every module source under e.g. "components/apps/".
function(ls_modules_filter list_var prefix)
    ls_modules_list(moved)
    set(srcs ${${list_var}})
    string(LENGTH "${prefix}" plen)
    foreach(f ${moved})
        string(FIND "${f}" "${prefix}" at)
        if(at EQUAL 0)
            string(SUBSTRING "${f}" ${plen} -1 tail)
            string(REPLACE "." "\\." tail "${tail}")
            list(FILTER srcs EXCLUDE REGEX "/${tail}$")
        endif()
    endforeach()
    set(${list_var} ${srcs} PARENT_SCOPE)
endfunction()
