{
  "version": 1,
  "sweep_rules": "/sdcard/sweep/rules.json",
  "defaults": {
    "enabled": false,
    "cooldown_s": 60,
    "dedupe": "rule_entity",
    "rule_cooldown_s": 120
  },
  "rules": [
    {
      "id": "remote-id",
      "enabled": true,
      "sources": [
        "rid.ble"
      ],
      "match": {
        "validated_message": true
      },
      "sinks": [
        "vibrate",
        "banner",
        "sd"
      ]
    },
    {
      "id": "with-you-trackers",
      "enabled": true,
      "sources": [
        "sweep.ble",
        "sweep.wifi"
      ],
      "match": {
        "category_in": [
          "TRACKER"
        ],
        "section_in": [
          "with_you"
        ]
      },
      "sinks": [
        "vibrate",
        "banner"
      ]
    },
    {
      "id": "cameras",
      "enabled": true,
      "sources": [
        "sweep.ble",
        "sweep.wifi"
      ],
      "match": {
        "category_in": [
          "CAMERA"
        ]
      },
      "sinks": [
        "banner"
      ]
    },
    {
      "id": "bodycam-example",
      "sources": [
        "sweep.ble"
      ],
      "match": {
        "category_in": [
          "BODYCAM"
        ]
      },
      "sinks": [
        "banner"
      ]
    },
    {
      "id": "wifi-example",
      "sources": [
        "sweep.wifi"
      ],
      "match": {
        "category_in": [
          "CAMERA"
        ]
      },
      "sinks": [
        "sd"
      ]
    },
    {
      "id": "drone-link-example",
      "enabled": false,
      "sources": [
        "lora.dronelink"
      ],
      "match": {
        "band_in": [
          "868",
          "915"
        ],
        "min_rssi_dbm": -100,
        "min_hits_per_min": 3
      },
      "sinks": [
        "banner",
        "sd"
      ]
    },
    {
      "id": "air-emergency-squawk",
      "enabled": true,
      "rule_cooldown_s": 0,
      "sources": ["adsb"],
      "match": {
        "squawk_in": ["7500", "7600", "7700"]
      },
      "sinks": ["vibrate", "banner"]
    },
    {
      "id": "air-emergency-status",
      "enabled": true,
      "rule_cooldown_s": 0,
      "sources": ["adsb"],
      "match": {
        "emergency_status": true
      },
      "sinks": ["vibrate", "banner"]
    },
    {
      "id": "air-callsign-watch",
      "sources": ["adsb"],
      "match": {
        "callsign_prefix_in": []
      },
      "sinks": ["banner"]
    },
    {
      "id": "air-icao-watch",
      "sources": ["adsb"],
      "match": {
        "icao_in": [],
        "icao_ranges": []
      },
      "sinks": ["banner"]
    },
    {
      "id": "air-nearby",
      "sources": ["adsb"],
      "match": {
        "distance_km_within": 10
      },
      "sinks": ["banner"]
    },
    {
      "id": "air-low",
      "sources": ["adsb"],
      "match": {
        "altitude_baro_ft_below": 1500
      },
      "sinks": ["banner"]
    },
    {
      "id": "air-category",
      "sources": ["adsb"],
      "match": {
        "adsb_category_in": ["rotorcraft"]
      },
      "sinks": ["banner"]
    },
    {
      "id": "drone-link-nearby",
      "enabled": true,
      "cooldown_s": 0,
      "rule_cooldown_s": 2,
      "sources": ["drone.watch"],
      "match": {"category_in": ["DRONE"]},
      "sinks": ["banner", "vibrate"]
    }
  ]
}
