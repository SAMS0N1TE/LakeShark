{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CARRIER rules v6 with aimed hyperspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ships",
    "commodity_base",
    "economy_slope",
    "equipment_cost",
    "laser_dps",
    "laser_range",
    "cooling",
    "fuel_price",
    "repair_price",
    "npc_damage",
    "shipyard",
    "combat",
    "reverse",
    "aim_assist_deg",
    "weapons_cool_s",
    "gimbal_deg",
    "turret_deg",
    "turret_rate_dps",
    "mount_damage",
    "mount_price"
  ],
  "properties": {
    "version": {
      "const": 6
    },
    "ships": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "commodity_base": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100000
      }
    },
    "economy_slope": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100000
      }
    },
    "equipment_cost": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100000
      }
    },
    "laser_dps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "laser_range": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "cooling": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "fuel_price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "repair_price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "npc_damage": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "shipyard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "trade_percent",
        "insurance_percent",
        "hulls"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "trade_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "insurance_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "hulls": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              {
                "type": "number",
                "minimum": 1,
                "maximum": 32
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[ -!#-\\[\\]-~]+$"
              }
            ],
            "items": false,
            "description": "Class-indexed rows 0..10: price, fuel ly, pylons, mounts, seats, minimum tech, government bit mask, stock percent, pitch. Hull, shields, speed, turn and cargo use the matching ships row."
          },
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/dogfish"
                }
              ]
            }
          ]
        }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damage",
        "weapons",
        "distributor",
        "defence",
        "supplies",
        "supply_price",
        "npc_weapons"
      ],
      "properties": {
        "damage": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 4
            }
          },
          "description": "THERMAL, KINETIC, EXPLOSIVE: shield and hull multipliers."
        },
        "weapons": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": false,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1000,
                "description": "damage"
              },
              {
                "type": "number",
                "minimum": 0.04,
                "maximum": 10,
                "description": "interval"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "capacitor"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "heat"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 2000,
                "description": "speed"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 30,
                "description": "life"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000,
                "description": "ammo"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000,
                "description": "price"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "description": "tech"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1,
                "description": "group"
              }
            ]
          },
          "description": "PULSE, BEAM, RATTLE GUN, SLUG GUN, SEEKER, DUMBFIRE. Projectile weapons require positive speed/life; RATTLE requires ammo."
        },
        "distributor": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "description": "SYS base/step, resistance per SYS above 2, ENG speed/turn per ENG above 2, ENG recharge base/step, WEP recharge base/step.",
          "prefixItems": [
            {},
            {},
            {
              "maximum": 0.4
            },
            {
              "maximum": 0.4
            },
            {
              "maximum": 0.4
            }
          ]
        },
        "defence": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 2000
          },
          "description": "Reboot seconds, cell fraction/heat, boost seconds/cooldown/speed/heat, chaff seconds, sink percent, oxygen seconds, overheat damage/s, canopy/module damage scale, scan seconds/range, lock seconds, normal/early accuracy, early shield regen multiplier.",
          "prefixItems": [
            {},
            {
              "maximum": 1
            },
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {
              "maximum": 1
            },
            {
              "maximum": 1
            },
            {
              "minimum": 1,
              "maximum": 4
            }
          ]
        },
        "supplies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Maximum SHIELD CELL, CHAFF, HEAT SINK counts."
        },
        "supply_price": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "description": "Dockside unit cost: SHIELD CELL, CHAFF, HEAT SINK."
        },
        "npc_weapons": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                255
              ]
            }
          },
          "description": "Mount kinds for pirates, police, Frill drones; 255 is empty. First mount required; single-mount pirates select one of the first two kinds by seeded identity."
        }
      }
    },
    "reverse": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "aim_assist_deg": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 90
      }
    },
    "weapons_cool_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60
    },
    "gimbal_deg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 90
    },
    "turret_deg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 90
    },
    "turret_rate_dps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "mount_damage": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 4
      }
    },
    "mount_price": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10
      }
    }
  },
  "$defs": {
    "dogfish": {
      "type": "array",
      "prefixItems": [
        {},
        {},
        {},
        {
          "const": 1
        }
      ]
    }
  }
}
