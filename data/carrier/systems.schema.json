{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "day_seconds",
    "scan_seconds",
    "heat_gain",
    "heat_cool",
    "scoop_rate",
    "heat_damage",
    "event_percent",
    "mission_days",
    "mission_reward",
    "fine",
    "trade_percent",
    "rank"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "day_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "scan_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "minimum": 60
    },
    "heat_gain": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "heat_cool": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "scoop_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "heat_damage": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "event_percent": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 300,
      "minimum": 100
    },
    "mission_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 365
    },
    "mission_reward": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "fine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "trade_percent": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 50
    },
    "rank": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "prefixItems": [
        {
          "const": 0
        }
      ],
      "description": "Strictly increasing weighted combat score thresholds; runtime validates ordering."
    }
  }
}
