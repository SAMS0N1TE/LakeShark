# ESP32-P4 rev 3 silicon (v3.0, v3.1: ROM esp32p4-eco5/eco6). Listed after
# the board's own defaults so it replaces the rev < 3 choice in
# sdkconfig.defaults. No image runs on both; this one needs the rev 3
# bootloader flashed with it.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
# CONFIG_ESP32P4_REV_MIN_1 is not set
CONFIG_ESP32P4_REV_MIN_300=y
