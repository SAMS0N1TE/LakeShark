# LS-004  ESP32-P4-NANO, headless radio core, Flipper head over BLE (and UART).
# Use with:  idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/nano_headless_ble.defaults"

CONFIG_LS_BOARD_P4_NANO=y
CONFIG_LAKESHARK_HEADLESS=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/partitions_16m.csv"

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y

CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# LS-814  These two were off, and the NANO headless build did not link:
# undefined reference to ble_svc_gap_init from ble_link_start().
#
# ble_link.c is a GAP CENTRAL - it scans (ble_gap_disc) and connects out to
# the Flipper, it never advertises. But ble_svc_gap_init() registers the GAP
# *service*, which is a GATT SERVER service, and NimBLE only builds that when
# the peripheral role is on. So a central still needs ROLE_PERIPHERAL here.
# Every role on, as boards/wifi6_headless_ble.defaults documents under LS-112.
# Verified on hardware 2026-09-05: BLE comes up and connects to the head.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=498
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_NVS_PERSIST=y
