CONFIG_LS_BOARD_T_DISPLAY_P4=y

CONFIG_LAKESHARK_HEADLESS=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/partitions_16m_ota.csv"
# Updates over WiFi: a new build runs on trial and the bootloader goes back
# to the last one if it never marks itself good.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# TLS in PSRAM. One HTTPS session wants more internal RAM than the board has
# free once the radios are up.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_LS_VBUS_EN_GPIO=-1

CONFIG_LS_C6_LINK=y
CONFIG_LS_BLE_HEAD=y
# A C6 that does not answer must not take the board down with it. Left on, the
# transport reboots the host 5s in, before the UI ever starts, and the board
# loops. Off, the probe gives up on its own and boot carries on without Wi-Fi.
# CONFIG_ESP_HOSTED_HOST_RESTART_NO_COMMUNICATION_WITH_SLAVE is not set
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE=n
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_ESP_HOSTED_SLAVE_RESET_ONLY_IF_NECESSARY=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=n
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT_0=n
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Full boot initializes Wi-Fi, USB and the compact console/UI in one call
# chain.  The IDF default is too small for newlib's formatted log frames.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Scanout must be serviced across flash access and large framebuffer/SD
# writebacks. No interrupt callback modifies these CPU-owned pixel/IQ buffers.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x4000

# MeshCore decrypts a 16-byte block at a time. The P4 AES unit runs every
# block through DMA and allocates its descriptors and alignment buffers from
# internal DMA memory, which ADS-B streaming nearly exhausts; a failed
# allocation left the mesh radio deaf. Software AES needs no DMA memory.
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# Task-only FreeRTOS APIs can wait for cache; FromISR/context-switch paths stay in IRAM.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
# PM is disabled; stop the sleep module selecting the optional IRAM latency optimization.
CONFIG_PM_SLEEP_FUNC_IN_IRAM=n
# Match 5.4.3: no optional light-sleep latency optimization.
CONFIG_PM_SLP_IRAM_OPT=n
# NimBLE host is task-context on the C6 transport; keep its new dynamic pools out of DMA RAM.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# C6 runs the Wi-Fi beacon/TBTT ISR; its P4 proxy needs no sleep IRAM optimization.
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
# Disable the Wi-Fi Remote alias too so it cannot reselect PM sleep IRAM placement.
CONFIG_WIFI_RMT_SLP_IRAM_OPT=n

# Cellset (index + four LRU files), places and a resumable download coexist.
# Keep the enlarged FAT file table and sector buffers in PSRAM.
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
CONFIG_FATFS_FS_LOCK=24

# Map downloads ran at ~100 KB/s against the 5760-byte default window.
# lwIP buffers come from PSRAM here (MALLOC_ALWAYSINTERNAL=0).
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=24
