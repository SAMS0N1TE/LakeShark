{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lsdk: build",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/lsdk.py",
        "build"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        {
          "owner": "lakeshark",
          "fileLocation": [
            "autoDetect",
            "${fileDirname}"
          ],
          "pattern": {
            "regexp": "^(.*?):(\\d+):(\\d+): (error|warning|note): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "lsdk: sim",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/lsdk.py",
        "sim"
      ],
