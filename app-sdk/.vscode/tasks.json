            "${fileDirname}"
          ],
          "pattern": {
            "regexp": "^(.*?):(\\d+):(\\d+): (error|warning|note): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ]
    },
    {
      "label": "lsdk: sim frames",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/lsdk.py",
        "sim",
        "--frames",
        "60"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        {
          "owner": "lakeshark",
