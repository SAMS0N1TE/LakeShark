            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ]
    },
    {
      "label": "lsdk: install and open",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/lsdk.py",
        "install",
        "--open"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        {
          "owner": "lakeshark",
          "fileLocation": [
